{
	"name": "@ingram-tech/registry",
	"version": "0.0.0",
	"private": true,
	"description": "Ingram Technologies' shadcn-style component registry. Copy-in, own-and-rebrand components shared across the fleet. Currently: transactional email (React Email) and the shared dashboard ui kit (Base UI + Tailwind v4).",
	"homepage": "https://github.com/ingram-technologies/registry#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/registry.git"
	},
	"type": "module",
	"scripts": {
		"build": "shadcn build",
		"lint": "oxlint",
		"format": "oxfmt --write .",
		"ci": "bun run check && bun run type-check && bun run test && bun run build",
		"check": "oxlint && oxfmt --check . && bun run scripts/check-site-names.ts",
		"type-check": "tsc --noEmit",
		"preview": "email dev --dir preview",
		"test": "vitest run"
	},
	"devDependencies": {
		"@base-ui/react": "^1.7.0",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"happy-dom": "^20.12.0",
		"lucide-react": "^1.37.0",
		"next": "16.3.3",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.80.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.3",
		"shadcn": "^4.19.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14"
}
